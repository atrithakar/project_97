<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <!-- <meta name="viewport" content="width=device-width, initial-scale=1.0"> -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Project 97 | Gallery</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>

<body>

    <header class="top-nav">
        <div class="logo">Project 97</div>

        <button class="mobile-toggle" aria-label="Toggle navigation">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="nav-controls">
            <input type="text" class="nav-input" placeholder="Search photos">

            <select class="nav-select" title="Filter by Time">
                <option value="">Time: Any</option>
                <option value="00:00-03:59">Late Night</option>
                <option value="04:00-05:59">Dawn</option>
                <option value="06:00-11:59">Morning</option>
                <option value="12:00-16:59">Afternoon</option>
                <option value="17:00-18:59">Dusk</option>
                <option value="19:00-20:59">Evening</option>
                <option value="21:00-23:59">Night</option>
            </select>

            <!-- <form action="/home" method="get"> -->
            <input type="hidden" name="map_x" id="map_x" value="">
            <input type="hidden" name="map_y" id="map_y" value="">
            <input type="hidden" name="map_radius" id="map_radius" value="">

            <button type="button" class="nav-btn" id="openMapFilter">📍 Region: Map Search</button>

            <dialog id="mapModal" class="map-modal">
                <div class="modal-header">
                    <h3>Select Search Area</h3>
                    <button type="button" id="closeMap" class="btn-ghost">✕</button>
                </div>

                <div class="modal-body">
                    <div id="filterMap" style="height: 500px; background: #050505;"></div>

                    <div class="radius-control">
                        <label for="radiusSlider">Search Radius: <span id="radiusOutput">1000</span> meters</label>
                        <input type="range" id="radiusSlider" min="100" max="4000" step="100" value="1000">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" id="applyMapFilter" class="nav-btn btn-primary">Apply Area Filter</button>
                </div>
            </dialog>
            <!-- </form> -->

            <select class="nav-select" title="Filter by Radio">
                <option value="">Radio: Any</option>
                <option value="Radio Off">Radio Off</option>

                <option value="RADIO_01_CLASS_ROCK">Los Santos Rock Radio</option>
                <option value="RADIO_02_POP">Non-Stop-Pop FM</option>
                <option value="RADIO_03_HIPHOP_NEW">Radio Los Santos</option>
                <option value="RADIO_09_HIPHOP_OLD">West Coast Classics</option>
                <option value="RADIO_04_PUNK">Channel X</option>
                <option value="RADIO_18_90S_ROCK">Vinewood Boulevard Radio</option>
                <option value="RADIO_06_COUNTRY">Rebel Radio</option>

                <option value="RADIO_07_DANCE_01">Soulwax FM</option>
                <option value="RADIO_14_DANCE_02">FlyLo FM</option>
                <option value="RADIO_16_SILVERLAKE">Radio Mirror Park</option>
                <option value="RADIO_20_THELAB">The Lab</option>
                <option value="RADIO_13_JAZZ">Worldwide FM</option>

                <option value="RADIO_15_MOTOWN">The Lowdown 91.1</option>
                <option value="RADIO_17_FUNK">Space 103.2</option>
                <option value="RADIO_12_REGGAE">The Blue Ark</option>

                <option value="RADIO_08_MEXICAN">East Los FM</option>

                <option value="RADIO_21_DLC_XM17">blonded Los Santos 97.8 FM</option>
                <option value="RADIO_22_DLC_BATTLE_MIX1_RADIO">Los Santos Underground Radio (LSUR)</option>
                <option value="RADIO_23_DLC_XM19_RADIO">iFruit Radio</option>
            </select>

            <button type="button" class="nav-btn btn-primary" id="openUploadModal">Upload</button>

            <dialog id="uploadModal" class="map-modal" style="max-width: 500px;">
                <div class="modal-header">
                    <h3>Upload Snapmatic</h3>
                    <button type="button" id="closeUpload" class="btn-ghost">✕</button>
                </div>

                <form id="uploadForm" action="/upload" method="POST" enctype="multipart/form-data">
                    <div class="modal-body" style="padding: 30px; gap: 20px;">
                        <div class="file-drop-zone"
                            style="border: 2px dashed rgba(58, 51, 44, 0.2); padding: 40px; text-align: center; border-radius: var(--radius-md); background: var(--bg-sandstone);">
                            <input type="file" name="snapmatic" id="snapmaticFile" style="display: none;" required
                                multiple>
                            <label for="snapmaticFile" style="cursor: pointer; display: block;">
                                <div style="font-size: 2.5rem; margin-bottom: 10px;">📸</div>
                                <strong>Click to select a Snapmatic file</strong>
                                <p style="font-size: 0.85rem; color: #666; margin-top: 5px;">Must start with 'PGTA' and
                                    have no extension</p>
                            </label>
                            <div id="fileSelectedName"
                                style="margin-top: 15px; font-weight: 600; color: var(--accent-terracotta);"></div>
                        </div>
                        <div id="uploadError"
                            style="color: #d9534f; font-size: 0.9rem; font-weight: 500; display: none;"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="nav-btn btn-primary" id="submitUploadBtn" disabled>Upload
                            Image</button>
                    </div>
                </form>
            </dialog>

            <a href="/profile" class="nav-btn">Profile</a>

            <form action="/logout" method="POST" class="inline-form">
                <button type="submit" class="nav-btn btn-ghost">Log Out</button>
            </form>
        </div>
    </header>

    <main class="feed-container">

    </main>

    <div id="loading-anchor" style="height: 50px; display: flex; justify-content: center;">
        <p>Loading more...</p>
    </div>


    <script src="/js/home.hamburger.js"></script>
    <script src="/js/home.map.js"></script>
    <script src="/js/home.upload.js"></script>
    <script src="/js/home.feed.js"></script>
</body>

</html>